<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Kalender perangkat untuk titik acara (opsional) -->
    <uses-permission android:name="android.permission.READ_CALENDAR" />
    <!-- Layanan layar kunci TV -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Diperlukan agar layar kunci TV bisa dimunculkan dari latar belakang (Android 10+) -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />
    <!-- Uninstall dari app drawer -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <!-- Gestur "buka notifikasi" (cadangan bila layanan aksesibilitas tidak aktif) -->
    <uses-permission android:name="android.permission.EXPAND_STATUS_BAR" />
    <!-- Getar halus saat tombol kaset ditekan / knob diputar -->
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Taskbar Vinyl: daftar aplikasi terakhir dibuka (izin khusus, diberikan pengguna di Pengaturan) -->
    <uses-permission
        android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />
    <!-- Pencarian kontak di app drawer (opsional, mati secara default; diminta saat pengguna menyalakannya) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />
    <!-- Lirik (lrclib.net), widget cuaca (open-meteo.com), dan cover album https. Hanya HTTPS; lihat Pengaturan → Cadangan & privasi -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!--
      Visualizer audio "Audio asli" (opsional, mati secara default). Android mewajibkan RECORD_AUDIO untuk android.media.audiofx.Visualizer
      dan MODIFY_AUDIO_SETTINGS untuk Visualizer pada keluaran sistem (sesi 0). Hanya spektrum FFT yang dibaca, tanpa rekaman; izin
      mikrofon baru diminta saat pengguna memilih mode itu di Pengaturan → Gambar & efek.
      MODIFY_AUDIO_SETTINGS juga dipakai equalizer Audio Console (DynamicsProcessing pada sesi audio yang dibuka aplikasi musik);
      EQ mati secara default.
    -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!--
      Akses lanjutan Audio Console (opsional). DUMP TIDAK bisa diminta lewat dialog dan tidak diberikan saat pemasangan:
      pengguna sendiri yang memberikannya lewat ADB ("adb shell pm grant com.vinyl.launcher android.permission.DUMP") atau
      lewat Shizuku setelah menyetujui. Dipakai untuk membaca laporan diagnostik audio & Bluetooth (codec aktif, format
      keluaran, resampling, sesi audio untuk equalizer). Isi laporan hanya dibaca di memori, tidak disimpan/dikirim.
    -->
    <uses-permission android:name="android.permission.DUMP" tools:ignore="ProtectedPermissions" />
    <!--
      Baterai earphone/speaker Bluetooth di Audio Console dan OSD beranda (opsional). Diminta hanya saat pengguna menekan
      "Izinkan baca baterai Bluetooth". Android 12+: BLUETOOTH_CONNECT; Android 10–11: BLUETOOTH (izin biasa, juga untuk membaca
      apakah Bluetooth menyala di OSD). Dipakai untuk menerima siaran level baterai dari sistem; tidak memindai, tidak
      menyambung, tidak mengubah perangkat. Level terakhir diingat di perangkat dengan kunci sidik SHA-256 alamat (bukan alamatnya).
    -->
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <!--
      OSD beranda (pengganti status bar): status Wi-Fi tersambung & kekuatannya, dan apakah internet lewat data seluler.
      Izin biasa (tanpa dialog). Nama jaringan TIDAK dibaca (butuh lokasi, tidak diminta). Media3 juga memakainya.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
      Pemutar musik bawaan (berkas di folder pilihan pengguna): layanan latar jenis mediaPlayback agar lagu tetap berjalan
      saat layar mati, dan wake lock CPU selama memutar (ExoPlayer WAKE_MODE_LOCAL). Keduanya izin biasa (tanpa dialog).
      MODIFY_AUDIO_SETTINGS (di atas) juga dipakai untuk "Laju sampel USB cocok" (Android 14+, opsional, mati bawaan).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Mikrofon bukan syarat memasang Vinyl: tanpa ini tablet tanpa mikrofon akan disaring dari instalasi -->
    <uses-feature android:name="android.hardware.microphone" android:required="false" />

    <!-- Visibilitas paket: daftar aplikasi yang bisa diluncurkan & aplikasi musik -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.APP_MUSIC" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MEDIA_BUTTON" />
        </intent>
        <!-- Akses lanjutan: memeriksa apakah aplikasi Shizuku terpasang (opsional) -->
        <package android:name="moe.shizuku.privileged.api" />
        <!-- Audio Console: pintasan pengaturan audio, hanya ditampilkan bila ada aplikasi yang menanganinya -->
        <intent>
            <action android:name="android.settings.SOUND_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.settings.panel.action.VOLUME" />
        </intent>
        <intent>
            <action android:name="android.settings.BLUETOOTH_SETTINGS" />
        </intent>
        <intent>
            <action android:name="android.media.action.DISPLAY_AUDIO_EFFECT_CONTROL_PANEL" />
        </intent>
    </queries>

    <application
        android:name=".VinylApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.VinylLauncher"
        android:enableOnBackInvokedCallback="true"
        tools:targetApi="36">

        <!-- HOME: layar utama ruang TV -->
        <activity
            android:name=".ui.home.HomeActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:clearTaskOnLaunch="true"
            android:stateNotNeeded="true"
            android:excludeFromRecents="true"
            android:resizeableActivity="true"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|density|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Titik masuk dari daftar aplikasi: onboarding lalu pengaturan -->
        <activity
            android:name=".ui.onboarding.OnboardingActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ui.settings.SettingsActivity"
            android:exported="false"
            android:label="@string/settings_title"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode" />

        <!-- Layar kunci TV: tampil di atas keyguard sistem -->
        <activity
            android:name=".ui.cover.CoverActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:taskAffinity="com.vinyl.launcher.cover"
            android:showWhenLocked="true"
            android:noHistory="false"
            android:theme="@style/Theme.VinylLauncher.Cover"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|uiMode" />

        <!-- Membaca & mengontrol sesi media dari aplikasi musik apa pun -->
        <service
            android:name=".service.MediaListenerService"
            android:exported="true"
            android:label="@string/app_name"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Memantau layar mati untuk memunculkan layar kunci TV -->
        <!--
          Pemutar bawaan (Media3). Tidak diekspor: hanya launcher ini yang mengikatnya; kendali sistem (notifikasi, layar
          kunci, headset, Bluetooth) lewat sesi media platform.
        -->
        <service
            android:name=".player.PlayerService"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <!--
          Tombol putar (headset, Bluetooth, layar kunci) setelah proses aplikasi dimatikan sistem: menyalakan PlayerService
          untuk melanjutkan antrean terakhir. Diekspor karena sistem yang mengirim tombol media; layanan hanya dinyalakan
          bila ada antrean tersimpan (lihat PlayerButtonReceiver), siaran lain diabaikan.
        -->
        <receiver
            android:name=".player.PlayerButtonReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="android.intent.action.MEDIA_BUTTON" />
            </intent-filter>
        </receiver>

        <service
            android:name=".service.CoverService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Menampilkan layar kunci kustom (cover screen) saat layar dimatikan" />
        </service>

        <!-- Taskbar Vinyl yang melayang di atas semua aplikasi -->
        <service
            android:name=".service.TaskbarService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Menampilkan taskbar pengganti di atas aplikasi lain" />
        </service>

        <service
            android:name=".service.NavButtonsService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Menampilkan tombol navigasi Vinyl (Back, Home, Recents) di atas aplikasi lain" />
        </service>

        <!-- Opsional: aksi gestur kunci layar & buka notifikasi -->
        <service
            android:name=".service.VinylAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <receiver
            android:name=".service.BootReceiver"
            android:exported="false">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>
        <!--
          Penerima binder Shizuku (library resmi Shizuku-API). Dilindungi INTERACT_ACROSS_USERS_FULL sehingga hanya sistem /
          Shizuku yang bisa memanggilnya, bukan aplikasi biasa. Tidak melakukan apa pun bila Shizuku tidak terpasang.
        -->
        <provider
            android:name="rikka.shizuku.ShizukuProvider"
            android:authorities="${applicationId}.shizuku"
            android:multiprocess="false"
            android:enabled="true"
            android:exported="true"
            android:permission="android.permission.INTERACT_ACROSS_USERS_FULL" />
    </application>
</manifest>
