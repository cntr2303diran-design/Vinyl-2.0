<?xml version="1.0" encoding="utf-8"?>
<!--
  Untuk Android 10-11 (minSdk 29; dataExtractionRules baru berlaku di Android 12+).
  android:allowBackup="false" sudah mematikan backup; berkas ini menuliskan hal yang sama secara eksplisit.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
